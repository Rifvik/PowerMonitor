<?xml version="1.0" encoding="utf-8"?>
<!--
  app.manifest
  ============
  Embeds a Windows application manifest into HWMonitor.exe.

  requireAdministrator:
    Forces UAC elevation on every launch.  LibreHardwareMonitorLib loads a
    kernel-mode driver (WinRing0x64.sys / inpoutx64.sys) to access hardware
    MSRs and SMU registers at Ring 0.  Without elevation the driver load fails
    silently and all power / clock sensors return null.

  dpiAwareness = PerMonitorV2:
    Correct high-DPI rendering (relevant if you later attach a WPF/WinForms UI).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="amd64"
      name="HWMonitor"
      type="win32" />

  <description>HWMonitor — Real-Time Hardware Telemetry Engine</description>

  <!-- ── UAC Trust Level ─────────────────────────────────────────────────── -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!--
          level="requireAdministrator"
            The OS will always display a UAC prompt before the process starts.
            The kernel driver cannot be installed without this.

          uiAccess="false"
            We do not need to interact with elevated windows from a lower
            integrity level, so keep this false (security best-practice).
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- ── Windows 10 / 11 Compatibility ──────────────────────────────────── -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- ── DPI Awareness ──────────────────────────────────────────────────── -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
        true/PM
      </dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2
      </dpiAwareness>
    </windowsSettings>
  </application>

</assembly>
