<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- GUI Application (no console window) -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HWMonitor</AssemblyName>
    <RootNamespace>HWMonitor</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Embed the requireAdministrator UAC manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Self-contained single-file publish (optional) -->
    <!-- Uncomment the lines below then run:
         dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -->
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <SelfContained>true</SelfContained> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- LibreHardwareMonitorLib from NuGet — provides Ring-0 MSR/SMU access -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2151.40" />
  </ItemGroup>

  <!-- Embed web resources -->
  <ItemGroup>
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
